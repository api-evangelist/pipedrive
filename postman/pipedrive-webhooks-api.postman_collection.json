              "raw": "{\n  \"subscription_url\": \"<string>\",\n  \"event_action\": \"delete\",\n  \"event_object\": \"user\",\n  \"name\": \"<string>\",\n  \"user_id\": \"<integer>\",\n  \"http_auth_user\": \"<string>\",\n  \"http_auth_password\": \"<string>\",\n  \"version\": \"2.0\"\n}",
