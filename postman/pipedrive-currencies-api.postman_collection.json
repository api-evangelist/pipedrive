      "item": [
        {
          "name": "Get all supported currencies",
          "id": "f2bda581-29ee-4ad5-b09b-d3df1a2b7647",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-token",
                  "type": "string"
                },
                {
                  "key": "value",
