  "info": {
    "_postman_id": "640d0939-8f33-42b3-aac1-de3ee21dcb50",
    "name": "Pipedrive API v1 Activities Meetings API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Activities are appointments/tasks/events on a calendar that can be associated with a deal, a lead, a person and an organization. Activities can be of different type (such as call, meeting, lunch or a custom type - see ActivityTypes object) and can be assigned to a particular user. Note that activities can also be created without a specific date/time.\n",
      "type": "text/plain"
    }
  }
