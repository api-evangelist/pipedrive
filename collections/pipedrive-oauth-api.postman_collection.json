{
  "item": [
    {
      "id": "9a4ce8f9-36cd-405b-9768-27ece3a0fc6b",
      "name": "Oauth",
      "description": {
        "content": "Using OAuth 2.0 is necessary for developing apps that are available in the Pipedrive Marketplace. Authorization via OAuth 2.0 is a well-known and stable way to get fine-grained access to an API. To retrieve OAuth2 tokens you should send requests to the `https://oauth.pipedrive.com` domain. After registering the app, you must add the necessary server-side logic to your app to establish the OAuth flow. Please read more about authorization step on the [Pipedrive Developers page](https://pipedrive.readme.io/docs/marketplace-oauth-authorization).\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f450a764-125f-4226-a624-8be126e8f5c9",
          "name": "Requesting authorization",
          "request": {
            "name": "Requesting authorization",
            "description": {
              "content": "Authorize a user by redirecting them to the Pipedrive OAuth authorization page and request their permissions to act on their behalf. This step is necessary to implement only when you allow app installation outside of the Marketplace.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "oauth",
                "authorize"
              ],
              "host": [
                "oauth",
                "pipedrive",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The client ID provided to you by the Pipedrive Marketplace when you register your app"
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "(Required) The callback URL you provided when you registered your app. Authorization code will be sent to that URL (if it matches with the value you entered in the registration form) if a user approves the app install. Or, if a customer declines, the corresponding error will also be sent to this URL."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "You may pass any random string as the state parameter and the same string will be returned to your app after a user authorizes access. It may be used to store the user's session ID from your app or distinguish different responses. Using state may increase security; see RFC-6749.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "60704179-85f8-4888-b325-a82358dae968",
              "name": "Authorize user in the app.",
              "originalRequest": {
                "url": {
                  "protocol": "https",
                  "path": [
                    "oauth",
                    "authorize"
                  ],
                  "host": [
                    "oauth",
                    "pipedrive",
                    "com"
                  ],
                  "query": [
                    {
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "key": "redirect_uri",
                      "value": "<string>"
                    },
                    {
                      "key": "state",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "text/html"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/html"
                }
              ],
              "body": "As a result of the request, the customer will see a page with the confirmation dialog, which will present the details of your app (title, company name, icon) and explain the permission scopes that you have set for the app. Customers should confirm their wish to install the app by clicking \"Allow and install\" or deny authorization by clicking \"Cancel\".\n",
              "cookie": [],
              "_postman_previewlanguage": "text"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        },
        {
          "id": "7277ec2c-86e6-498b-be64-d22f6d0c46fe",
          "name": "Getting the tokens",
          "request": {
            "name": "Getting the tokens",
            "description": {
              "content": "After the customer has confirmed the app installation, you will need to exchange the `authorization_code` to a pair of access and refresh tokens. Using an access token, you can access the user's data through the API.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "oauth",
                "pipedrive",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "authorization_code",
                  "description": "Since you are trying to exchange an authorization code for a pair of tokens, you must use the value \"authorization_code\""
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "The authorization code that you received after the user confirmed app installation"
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "The callback URL you provided when you registered your app"
                }
              ]
            }
          },
          "response": [
            {
              "id": "d7520955-151f-4f0e-ad72-307a0ded3bb7",
