            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pipedrive.com/v1/legacyTeams",
            "params": [
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The field name to sort returned teams by"
              },
              {
                "name": "skip_users",
                "value": "",
                "type": "query",
                "description": "When enabled, the teams will not include IDs of member users"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-token",
              "value": "{{x-api-token}}",
              "placement": "header"
            }
          },
          "docs": "Returns data about teams within the company."
        },
