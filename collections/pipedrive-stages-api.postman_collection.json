  "item": [
    {
      "id": "6a95f7fe-f116-4915-93c2-646327b7f1e2",
      "name": "Stages",
      "description": {
        "content": "Stage is a logical component of a pipeline, and essentially a bucket that can hold a number of deals. In the context of the pipeline a stage belongs to, it has an order number which defines the order of stages in that pipeline.\n",
        "type": "text/plain"
      },
      "item": [
