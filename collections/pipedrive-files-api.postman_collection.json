    {
      "id": "530be1aa-f804-4e47-aa3a-fcf54fe04ec6",
      "name": "Files",
      "description": {
        "content": "Files are documents of any kind (images, spreadsheets, text files, etc.) that are uploaded to Pipedrive, and usually associated with a particular deal, person, organization, product, note or activity. Remote files can only be associated with a particular deal, person or organization. Note that the API currently does not support downloading files although it lets you retrieve a file’s meta-info along with a URL which can be used to download the file by using a standard HTTP GET request.\n",
        "type": "text/plain"
      },
