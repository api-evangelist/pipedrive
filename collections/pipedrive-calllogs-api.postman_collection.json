    {
      "id": "e623b96d-96dd-4387-a97f-4eb3c7195503",
      "name": "CallLogs",
      "description": {
        "content": "Call logs describe the outcome of a phone call managed by an integrated provider. Since these logs are also considered activities, they can be associated with a deal or a lead, a person and/or an organization. Call logs do differ from other activities, as they only receive the information needed to describe the phone call.\n",
        "type": "text/plain"
      },
