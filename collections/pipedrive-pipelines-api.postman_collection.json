          "name": "Get deals in a pipeline",
          "request": {
            "name": "Get deals in a pipeline",
            "description": {
              "content": "Lists deals in a specific pipeline across all its stages. If no parameters are provided open deals owned by the authorized user will be returned. <br>This endpoint has been deprecated. Please use <a href=\"https://developers.pipedrive.com/docs/api/v1/Deals#getDeals\" target=\"_blank\" rel=\"noopener noreferrer\">GET /api/v2/deals?pipeline_id={id}</a> instead.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pipelines",
                ":id",
                "deals"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filter_id",
                  "value": "<integer>",
                  "description": "If supplied, only deals matching the given filter will be returned"
                },
                {
                  "disabled": false,
                  "key": "user_id",
                  "value": "<integer>",
                  "description": "If supplied, `filter_id` will not be considered and only deals owned by the given user will be returned. If omitted, deals owned by the authorized user will be returned."
                },
                {
                  "disabled": false,
                  "key": "everyone",
                  "value": "<number>",
                  "description": "If supplied, `filter_id` and `user_id` will not be considered – instead, deals owned by everyone will be returned"
