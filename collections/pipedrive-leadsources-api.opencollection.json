{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pipedrive API v1 Activities LeadSources API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "LeadSources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all lead sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pipedrive.com/v1/leadSources",
            "auth": {
              "type": "apikey",
              "key": "x-api-token",
              "value": "{{x-api-token}}",
              "placement": "header"
            }
          },
          "docs": "Returns all lead sources. Please note that the list of lead sources is fixed, it cannot be modified. All leads created through the Pipedrive API will have a lead source `API` assigned.\n"
        }
      ]
    }
  ],
  "bundled": true
}